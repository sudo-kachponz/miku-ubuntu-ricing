# Mako notif — tamagotchi shell theme (white + pink)
font=JetBrainsMono Nerd Font 11
background-color=#F5F0F0F0
text-color=#2A2A35
border-color=#F0A0B0
border-size=3
border-radius=22
padding=16
margin=12
default-timeout=5000
width=380
height=160
anchor=top-right
icons=1
max-icon-size=56
layer=overlay

[urgency=low]
border-color=#E8C8D0

[urgency=normal]
border-color=#F0A0B0

[urgency=high]
border-color=#E87090
default-timeout=0

[app-name=Slack]
border-color=#E8A0D0
background-color=#FFF5F8F0

[app-name=slack]
border-color=#E8A0D0
background-color=#FFF5F8F0
