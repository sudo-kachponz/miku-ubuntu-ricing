# cava — audio visualizer, gradient teal->pink (palette rice). Install: apt install cava
[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 30
higher_cutoff_freq = 16000

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#39B5B5'
gradient_color_2 = '#2DD4C0'
gradient_color_3 = '#F5A9BC'
gradient_color_4 = '#E85880'

[smoothing]
noise_reduction = 0.6
monstercat = 1
waves = 0

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
